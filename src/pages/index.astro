---
import Layout from "@components/Layout.astro";
import projects from "../projects.json";
---

<Layout title="Pretham Muthappa" description="Pretham's personal website">
	<h1 class="mb-3 text-3xl font-semibold">Hi, I'm Pretham.</h1>
	<p class="text-zinc-800">
		I enjoy working with cloud infrastructure, containers, automation and Linux. Alongside my role as a  <span class="text-emerald-600">SOC Analyst</span>, I spend my time building practical cybersecurity projects and home labs. Other than tech, I enjoy playing Rainbow Six Siege, Fortnite and a Couple of other games. I collect graphic novels and also a Huge fan of Yu-Gi-Oh!
	</p>
	<p class="mt-4 text-zinc-800">Feel free to connect with me on <a class=" underline  hover:no-underline text-sky-400 " href="https://x.com/PrethamBachira">Twitter</a> or via <a class=" underline  hover:no-underline text-red-400" href="mailto:prethambachira1819@gmail.com"> Email </a>  </p><br/>
	<p class="mt-2 text-zinc-800" >Currently exploring  <span class="text-red-500">Oracle Cloud Infrastructure (OCI)</span></p>

	<section class="mt-4">
		<h2 class="mb-2 text-2xl font-semibold">Projects.</h2>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
			{
				projects.map((project) => {
					return (
						<article class="group rounded-md border px-4 pb-3  pt-2">
							<a href={new URL(project.repository, "https://github.com")} class="block">
								<h3 class="w-fit group-hover:text-main group-hover:underline">{project.name}</h3>
								<p class=" text-sm text-zinc-500">{project.description}</p>
							</a>
						</article>
					);
				})
			}
		</div>
	</section>

	<section>
			<section class="space-y-8">
				<div class="mt-10">

					<h1 class="text-2xl font-bold tracking-tight">Work Experience.</h1>
				</div>
				<div class="space-y-6">
					<div class="grid gap-4">
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-lg font-semibold">Platform Operations Specialist</h3>
								<p class="text-muted-foreground">ZeroFox | Apr 2025 - Present</p>
							</div>
						</div>
						<p class="text-muted-foreground">
							Conducted external threat monitoring and analysis to safeguard client data from digital risks, including phishing, impersonation, and data leaks. Ensured continuous protection of brand assets and digital presence for clients through proactive threat hunting.
							</br>
							Perform threat analysis using internal security platforms.
							</br>

						</p>
					</div>
					<div class="grid gap-4">
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-lg font-semibold">Java/Spring Boot Developer Intern</h3>
								<p class="text-muted-foreground">Incture | Jan 2024 - Aug 2024</p>
							</div>
						</div>
						<p class="text-muted-foreground">
							Engineered and validated robust RESTful APIs using Spring Boot for seamless user authentication and
							authorization, leveraging Hibernate for optimized data persistence in MySQL.
						</p>
					</div>
					<div class="grid gap-4">
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-lg font-semibold">Backend Developer Intern</h3>
								<p class="text-muted-foreground">WNE3 Technologies | Aug 2023 - Oct 2023</p>
							</div>
						</div>
						<p class="text-muted-foreground">
							Contributed significantly to the enhancement of a web3-driven e-commerce platform, focusing on optimizing user
							experience and integrating advanced technologies.
						</p>
					</div>
				</div>
			</section>
	</section>
<section>
  <h1 class="mb-2 mt-10 text-2xl font-semibold">Tech & Tools.</h1>

  <div class="space-y-5 p-4">


    <div>
      <h2 class="mb-2 text-lg font-semibold">Cybersecurity</h2>
      <p>SIEM • Splunk • Wireshark • Burp Suite • OWASP Top 10</p>
    </div>

    <div>
      <h2 class="mb-2 text-lg font-semibold">Cloud & DevOps</h2>
      <p>Oracle Cloud Infrastructure (OCI) • Azure • Docker • Linux • Nginx • Git • Terraform • CI/CD</p>
    </div>

    <div>
      <h2 class="mb-2 text-lg font-semibold">Development</h2>
      <p>Spring Boot • Spring Security • PostgreSQL •  REST APIs</p>
    </div>

      <div>
          <h2 class="mb-2 text-lg font-semibold">Programming</h2>
          <p>Java • Python • Go (Learning) • Bash</p>
        </div>


  </div>
</section>
	<hr>
	<footer>
		<p class="font-bold text-2xl mb-4 mt-4">Connect.</p>
		<div class="flex justify-center  items-center">
			<ul class="flex space-x-5 sm:space-x-9">
				<li><a href="mailto:prethambachira1819@gmail.com" class="hover:underline">Email</a></li>
				<li><a href="https://x.com/PrethamBachira" class="hover:underline">Twitter</a></li>
				<li><a href="https://www.linkedin.com/in/pretham-muthappa-b-s-602340231/" class="hover:underline">Linkedin</a></li>
				<li><a href="https://drive.google.com/file/d/1TCrgKrZj3l-Xqtyc-NNwMXuXFgpP7E0Y/view?usp=sharing" class="hover:underline">Resume</a></li>
				<li><a href="https://github.com/PrethamMuthappa" class="hover:underline">Github</a></li>
			</ul>
		</div>
		<div class="mt-6 text-center text-sm text-gray-600">
					<p>&copy; 2026 Pretham Muthappa B S.</p>
				</div>
	</footer>

</Layout>
